{
  "name": "sarangbang-server",
  "version": "0.9.0",
  "description": "사랑방 채팅 서버",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/index.js",
    "gui": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win nsis portable"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "main": "gui/main.js",
  "build": {
    "appId": "kr.sarangbang.server",
    "productName": "Sarangbang Server",
    "files": [
      "src/**/*",
      "gui/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
